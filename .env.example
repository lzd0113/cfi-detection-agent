# LLM provider API keys — 在哪个填了 key 就能用哪个模型
# 对应 config.yaml 里 llm.model 的 provider 前缀
# litellm 自动按 provider 名读取对应环境变量

# OpenAI 系 (model: openai/gpt-4o, openai/gpt-4o-mini ...)
OPENAI_API_KEY=

# Anthropic (model: anthropic/claude-3-5-sonnet-... )
ANTHROPIC_API_KEY=

# 阿里通义千问 / DashScope (model: dashscope/qwen-turbo, dashscope/qwen-plus ...)
DASHSCOPE_API_KEY=

# DeepSeek (model: deepseek/deepseek-chat)
DEEPSEEK_API_KEY=

# Moonshot Kimi (model: moonshot/moonshot-v1-8k)
MOONSHOT_API_KEY=

# OpenAI 兼容的任意第三方端点 (自定义 base_url)，见 config.yaml llm.base_url
# OPENAI_API_KEY=  可复用为兼容端点的 key
